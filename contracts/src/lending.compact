// defi1 — ZK under-collateralized lending pool
//
// Compact >= 0.23 (compact-runtime 0.16.x). Patterns cross-checked against
// Midnight-Skills templates/locker-dapp, templates/private-party-dapp,
// .agents/skills/compact and .agents/skills/example-zk-loan-application.
//
// Privacy boundary
//   private (witness): borrower identity secret, raw attestation values,
//                      cross-chain score, Merkle paths
//   public  (ledger) : pool liquidity, tier rules, issuer attestation root,
//                      loan records keyed by a pseudonymous nullifier,
//                      defaulters (revealed only on liquidation)
//   disclosed        : nullifier, tier, principal, collateral, and the single
//                      boolean `score >= tier`. Never the score or the raw data.

pragma language_version >= 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

struct TierRule {
  minScore: Uint<64>,
  maxLtvBps: Uint<64>,   // basis points, 10000 = 100%
  aprBps: Uint<64>
}

struct LoanRecord {
  tier: Uint<8>,
  principal: Uint<64>,
  collateral: Uint<64>,
  dueTime: Uint<64>,     // unix seconds; liquidatable once block time >= this
  active: Boolean
}

// ---------------------------------------------------------------------------
// Public (ledger) state
// ---------------------------------------------------------------------------

// Domain-hashed public key of the mock attestation issuer. Set once at deploy.
export sealed ledger issuerPk: Bytes<32>;

// Issuer-maintained tree of attestation-commitment leaves. HistoricMerkleTree so
// a borrower's proof stays valid even if the issuer adds more attestations
// between proof generation and submission.
export ledger attestationRoot: HistoricMerkleTree<10, Bytes<32>>;

export ledger poolLiquidity: Uint<64>;
export ledger tier0: TierRule;
export ledger tier1: TierRule;

// nullifier -> loan. The nullifier is a pseudonymous borrower id: one active
// loan per identity, and `repay`/`liquidate` act on it without a fresh proof of
// identity from third parties.
export ledger loans: Map<Bytes<32>, LoanRecord>;
export ledger activeNullifiers: Set<Bytes<32>>;
export ledger loanCount: Counter;

// Populated only by `liquidate` — the one place an identity is revealed.
export ledger defaulters: Set<Bytes<32>>;

// ---------------------------------------------------------------------------
// Private (witness) inputs — bodies in contracts/src/witnesses.ts
// ---------------------------------------------------------------------------

// Long-lived identity secret of whoever is calling.
witness callerSecret(): Bytes<32>;

// Each attestation: (value, expiry, Merkle path proving it was issued).
witness bankAttestation(): [Uint<64>, Uint<64>, MerkleTreePath<10, Bytes<32>>];
witness salaryAttestation(): [Uint<64>, Uint<64>, MerkleTreePath<10, Bytes<32>>];
witness repayAttestation(): [Uint<64>, Uint<64>, MerkleTreePath<10, Bytes<32>>];

// Score contributed by verified external wallets. Attested exactly like the
// other three: the issuer (acting as the cross-chain oracle) checks the
// borrower's ownership proof for the external address, derives a bounded
// contribution from that wallet's history, and commits a leaf. An
// unconstrained witness here would let any borrower mint their own score.
// Every subject gets a zero-valued leaf at onboarding, so a borrower who has
// linked nothing still has a path to prove.
witness crossChainAttestation(): [Uint<64>, Uint<64>, MerkleTreePath<10, Bytes<32>>];

// ---------------------------------------------------------------------------
// Key derivation — every hash carries a unique domain separator
// ---------------------------------------------------------------------------

// Longest loan a borrower may open, in seconds (90 days). Exposed as a circuit
// so the client reads the same bound the chain enforces (Compact has no
// module-level constants).
export pure circuit maxLoanTermSeconds(): Uint<64> {
  return 7776000;
}

export pure circuit deriveIssuerPk(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "defi1:issuer:v1"), sk]);
}

// Pseudonymous borrower id used as the loan key + double-borrow guard.
export pure circuit makeNullifier(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "defi1:nullifier:v1"), sk]);
}

// Distinct domain: binds an attestation to a subject without linking to the
// nullifier.
export pure circuit makeSubjectId(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "defi1:subject:v1"), sk]);
}

// Attestation leaf the issuer commits into `attestationRoot`.
export pure circuit attestationLeaf(
  fieldTag: Bytes<32>,
  value: Uint<64>,
  expiry: Uint<64>,
  subject: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    fieldTag,
    subject,
    persistentHash<Uint<64>>(value),
    persistentHash<Uint<64>>(expiry)
  ]);
}

// Credit score from the three attestation values plus the cross-chain
// contribution. The single source of truth — `borrow` and score.ts both mirror
// these weights.
export pure circuit scoreOf(
  bankValue: Uint<64>,
  salaryValue: Uint<64>,
  repayValue: Uint<64>,
  crossChain: Uint<64>
): Uint<64> {
  return (bankValue * 2 + salaryValue * 3 + repayValue * 4 + crossChain) as Uint<64>;
}

// ---------------------------------------------------------------------------
// Constructor
// ---------------------------------------------------------------------------

constructor(issuerSecret: Bytes<32>) {
  issuerPk = disclose(deriveIssuerPk(issuerSecret));
  poolLiquidity = 0;
  // Tier 0: conservative, over-collateralized (borrow at most half the
  // collateral). Tier 1: a stronger private score buys genuine
  // under-collateralization — 150% of collateral, 3x the tier-0 ceiling.
  tier0 = TierRule { minScore: 500,  maxLtvBps: 5000,  aprBps: 900 };
  tier1 = TierRule { minScore: 750,  maxLtvBps: 15000, aprBps: 1400 };
}

// ---------------------------------------------------------------------------
// Attestation issuance (mock issuer)
// ---------------------------------------------------------------------------

// The issuer publishes an attestation commitment. Callable only by the account
// whose derived key matches `issuerPk`.
export circuit issueAttestation(leaf: Bytes<32>): [] {
  assert(deriveIssuerPk(callerSecret()) == issuerPk, "caller is not the issuer");
  attestationRoot.insert(disclose(leaf));
}

// ---------------------------------------------------------------------------
// Liquidity
// ---------------------------------------------------------------------------

export circuit depositLiquidity(amount: Uint<64>): [] {
  poolLiquidity = disclose((poolLiquidity + amount) as Uint<64>);
}

export circuit withdrawLiquidity(amount: Uint<64>): [] {
  const amt = disclose(amount);
  assert(amt <= poolLiquidity, "insufficient pool liquidity");
  poolLiquidity = (poolLiquidity - amt) as Uint<64>;
}

// ---------------------------------------------------------------------------
// Borrow
// ---------------------------------------------------------------------------

// Verify one attestation against the issuer root and return its value.
circuit verifiedValue(
  fieldTag: Bytes<32>,
  subject: Bytes<32>,
  att: [Uint<64>, Uint<64>, MerkleTreePath<10, Bytes<32>>]
): Uint<64> {
  const value = att[0];
  const expiry = att[1];
  const path = att[2];
  // Disclose the reconstructed root: on success it just equals the already-public
  // tree root. The path's siblings and the leaf position stay private.
  assert(
    attestationRoot.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
    "attestation not issued by the issuer"
  );
  // Bind the proven leaf to the claimed (value, expiry, subject) so the prover
  // can't swap in a different real leaf. Assert only — no disclosure.
  assert(
    path.leaf == attestationLeaf(fieldTag, value, expiry, subject),
    "attestation path does not match its contents"
  );
  assert(!blockTimeGte(disclose(expiry)), "attestation expired");
  return value;
}

export circuit borrow(
  useTier1: Boolean,
  amount: Uint<64>,
  collateral: Uint<64>,
  dueTime: Uint<64>
): [] {
  const secret = callerSecret();

  // Public by design: tier, amount, collateral, due time, and the nullifier.
  const t1  = disclose(useTier1);
  const amt = disclose(amount);
  const col = disclose(collateral);
  const due = disclose(dueTime);

  const nullifier = disclose(makeNullifier(secret));
  assert(!activeNullifiers.member(nullifier), "identity already has an active loan");
  assert(blockTimeLt(due), "due time must be in the future");

  // Term cap. There is no block-time getter, only the two comparators, so the
  // bound is expressed as a second comparison: `due - maxLoanTermSeconds()`
  // must already be in the past, which is exactly `due <= now + MAX_TERM`.
  // The branch keeps the Uint subtraction from underflowing for a `due` inside
  // the first 90 days of the epoch (where the bound is vacuous anyway).
  const maxTerm = maxLoanTermSeconds();
  const termFloor = (due >= maxTerm ? (due - maxTerm) : 0) as Uint<64>;
  assert(blockTimeGte(termFloor), "loan term exceeds the maximum");

  // --- score, computed entirely over private data ---
  const subject = makeSubjectId(secret);
  const bankV   = verifiedValue(pad(32, "defi1:att:bank:v1"),   subject, bankAttestation());
  const salaryV = verifiedValue(pad(32, "defi1:att:salary:v1"), subject, salaryAttestation());
  const repayV  = verifiedValue(pad(32, "defi1:att:repay:v1"),  subject, repayAttestation());
  const crossV  = verifiedValue(pad(32, "defi1:att:crosschain:v1"), subject, crossChainAttestation());

  const score = scoreOf(bankV, salaryV, repayV, crossV);

  const rule = t1 ? tier1 : tier0;
  assert(disclose(score >= rule.minScore), "score below required tier");

  // amount / collateral <= maxLtvBps / 10000
  assert(
    (amt * 10000) as Uint<64> <= (col * rule.maxLtvBps) as Uint<64>,
    "exceeds max LTV for tier"
  );
  assert(amt <= poolLiquidity, "insufficient pool liquidity");

  const tierId = (t1 ? 1 : 0) as Uint<8>;
  loans.insert(nullifier, LoanRecord {
    tier: tierId,
    principal: amt,
    collateral: col,
    dueTime: due,
    active: true
  });
  activeNullifiers.insert(nullifier);
  poolLiquidity = (poolLiquidity - amt) as Uint<64>;
  loanCount.increment(1);
}

// ---------------------------------------------------------------------------
// Repay
// ---------------------------------------------------------------------------

export circuit repay(amount: Uint<64>): [] {
  const nullifier = disclose(makeNullifier(callerSecret()));
  assert(activeNullifiers.member(nullifier), "no active loan for identity");
  const loan = loans.lookup(nullifier);
  assert(disclose(amount) >= loan.principal, "repayment below principal");

  loans.remove(nullifier);
  activeNullifiers.remove(nullifier);
  poolLiquidity = disclose((poolLiquidity + amount) as Uint<64>);
}

// ---------------------------------------------------------------------------
// Liquidate — the only circuit that reveals an identity, and it reveals
// nothing else
// ---------------------------------------------------------------------------

export circuit liquidate(nullifier: Bytes<32>): [] {
  const n = disclose(nullifier);
  assert(activeNullifiers.member(n), "no active loan");
  const loan = loans.lookup(n);
  assert(blockTimeGte(loan.dueTime), "loan not yet in default");

  // seize collateral into the pool, close the loan, publish the defaulter
  poolLiquidity = (poolLiquidity + loan.collateral) as Uint<64>;
  loans.remove(n);
  activeNullifiers.remove(n);
  defaulters.insert(n);
}
