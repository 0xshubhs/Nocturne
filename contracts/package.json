{
  "name": "@defi1/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compact": "compact compile src/lending.compact src/managed/lending",
    "compact:fast": "compact compile --skip-zk src/lending.compact src/managed/lending",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "issuer:mint": "tsx scripts/mint-personas.ts",
    "issuer:new-key": "tsx scripts/mint-personas.ts --new-key",
    "demo": "tsx scripts/demo.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.19.0"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  }
}
