{
  "name": "nocturne",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync:zk": "mkdir -p public/zk/lending && cp -R contracts/src/managed/lending/keys contracts/src/managed/lending/zkir public/zk/lending/",
    "proof-server:up": "docker run -d --rm --name nocturne-proof-server -p 6300:6300 midnightnetwork/proof-server:latest",
    "proof-server:down": "docker rm -f nocturne-proof-server",
    "test:prove": "PROVE_LIVE=1 vitest run src/lib/midnight/prove-live.test.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "^5.0.0-beta.7",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@nocturne/contracts": "*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@midnight-ntwrk/compact-runtime": "0.19.0"
  },
  "workspaces": [
    "contracts"
  ]
}
